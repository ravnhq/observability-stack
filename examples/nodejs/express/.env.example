# ===== TELEMETRY CONFIGURATION =====
TELEMETRY_ENABLED=true
SERVICE_NAME=minimal-metrics-api
SERVICE_VERSION=1.0.0
OTLP_ENDPOINT=http://localhost:4318
METRIC_EXPORT_INTERVAL=2000
NODE_ENV=development

# ===== LOKI CONFIGURATION =====
LOG_LEVEL=info
LOKI_URL=http://localhost:3100

# ===== PYROSCOPE CONFIGURATION =====
PYROSCOPE_ENABLED=true
PYROSCOPE_ENDPOINT=http://localhost:4040

# ===== APPLICATION CONFIGURATION =====
PORT=3001

# ===== DATABASE CONFIGURATION =====
# Update this with your actual PostgreSQL credentials
DATABASE_URL="postgresql://postgres:admin@localhost:5432/example"

# ===== OBSERVABILITY STACK ENDPOINTS =====
# These are for reference - your LGTM stack endpoints
GRAFANA_URL=http://localhost:3030
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200