# ===================================================
# Spring Boot Application Configuration
# ===================================================

SPRING_APPLICATION_NAME=myapp
SERVER_PORT=8080

# ===================================================
# OpenTelemetry Configuration
# ===================================================

# Service Identification
OTEL_SERVICE_NAME=myapp
OTEL_SERVICE_VERSION=1.0.0
OTEL_DEPLOYMENT_ENVIRONMENT=development

# OTLP Exporter Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Exporters Configuration
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# ===================================================
# OpenTelemetry Instrumentation Configuration
# ===================================================

# Enable default instrumentations
OTEL_INSTRUMENTATION_COMMON_DEFAULT_ENABLED=true
OTEL_INSTRUMENTATION_SPRING_WEB_ENABLED=true

# MDC/Logging Configuration for trace correlation
OTEL_INSTRUMENTATION_COMMON_MDC_ENABLED=true
OTEL_INSTRUMENTATION_LOGBACK_MDC_ADD_BAGGAGE=true

# ===================================================
# Node Exporter Configuration
# ===================================================
NODE_EXPORTER_PORT=9100

# ===================================================
# Logging Configuration
# ===================================================

LOG_LEVEL=INFO
